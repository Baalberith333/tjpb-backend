<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TJPB Cadastro de Processos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>

    <div class="container">
        
        <header id="headingContainer" class="heading_container">
            
            <%- include ("hero") %>
        </header>
        
    <main id="mainContainer" class="main_container">
        
        <%- include ("register")%>
        
        <section id="listContainer" class="case_list_container">
            <h1>TJPB Processos</h1>
            
            <table id="caseTable" class="case_tabe data_table">
                
                <thead>
                    <tr>
                        <th>Número do Processo</th>
                        <th>Classe Processual</th>
                        <th>Data do Processo</th>
                        <th>Assunto</th>
                        <th>Prazo para Conclusão</th>
                        <th>Situaçao Atual</th>
                        <th>Responsável</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                
                <tbody>
                    
                    <% caseList.forEach(caseItem => {%>
                        <tr class="case_row" data-id="<%=caseItem._id%>">
                            
                            <td><%= caseItem.number %></td>
                            <td><%= caseItem.type %></td>
                            <td><%= caseItem.date %></td>
                            <td><%= caseItem.subject %></td>
                            <td><%= caseItem.deadLine %></td>
                            <td><%= caseItem.status %></td>
                            <td><%= caseItem.responsible %></td>
                            <td>
                                <div class="action_btn_container">
                                    <button id="editBtn" class="edit_btn btn table_btn">
                                        <i class="bi bi-pencil-square"></i>
                                        
                                    </button>
                                    <button id="deleteBtn" class=" btn delete_btn table_btn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>   
                        <%})%>
                    </tbody>
                </table>
            </section>
        </main>
        
        <footer id="foot_container" class="foot_container">
            <%- include("footer")%>
        </footer>
        
    </div>
    <script src="/js/script.js"></script>
</body>
</html>